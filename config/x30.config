# ==========================================================
# OpenWrt Configuration for TOTOLINK X30 (STC Wi-Fi 6 Mesh)
# Target: MediaTek Filogic (MT7981B)
# ==========================================================

# 1. Target Hardware
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_totolink_X30=y

# 2. Web Interface (LuCI)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# 3. Hardware Wi-Fi 6 Support (MT7976C / MT7915)
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# 4. Core System & Security Tools
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y

# 5. Build Logging
CONFIG_BUILD_LOG=y

# ==========================================================
# Optional Additions (Uncomment if needed):
# ==========================================================
# SQM / CAKE Bufferbloat control:
# CONFIG_PACKAGE_luci-app-sqm=y
# CONFIG_PACKAGE_sqm-scripts=y
# CONFIG_PACKAGE_kmod-sched-cake=y

# WireGuard VPN:
# CONFIG_PACKAGE_luci-app-wireguard=y
# CONFIG_PACKAGE_wireguard-tools=y
